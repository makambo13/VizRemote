default_platform(:ios)

PROJECT = "VizRemote.xcodeproj"
def ensure_developer_account_configured
  team_id = ENV["FASTLANE_TEAM_ID"] || CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
  unless team_id
    UI.user_error!(
      "No paid Apple Developer Program team_id is configured yet. " \
      "Archive/upload lanes need real signing certificates and an App Store Connect " \
      "record, which require an active membership at developer.apple.com/account. " \
      "Once enrolled, set team_id in fastlane/Appfile (or FASTLANE_TEAM_ID) and re-run. " \
      "The *_test and *_build lanes work fine without this."
    )
  end
end

# ---------------------------------------------------------------------------
# macOS (VizRemote)
# ---------------------------------------------------------------------------

desc "Run the macOS unit test suite (VizRemoteTests)"
lane :mac_test do
  run_tests(
    project: PROJECT,
    scheme: "VizRemote",
    destination: "platform=macOS",
    result_bundle: true
  )
end

desc "Debug build sanity check — compiles the app, no signing/export/upload"
lane :mac_build do
  sh("cd .. && xcodebuild -project #{PROJECT} -scheme VizRemote -configuration Debug build")
end

desc "Archive, sign, and upload to the Mac App Store — requires a paid Developer Program membership"
lane :mac_release do
  ensure_developer_account_configured
  build_mac_app(
    project: PROJECT,
    scheme: "VizRemote",
    export_method: "app-store"
  )
  upload_to_app_store(
    skip_screenshots: true,
    skip_metadata: false,
    submit_for_review: false # leave the actual review submission as a manual step for now
  )
end

# ---------------------------------------------------------------------------
# Combined
# ---------------------------------------------------------------------------

desc "Run the macOS tests and confirm the app builds"
lane :ci do
  mac_test
  mac_build
end
